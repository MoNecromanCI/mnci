{
  "name": "@mnci/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "mnci run build",
    "lint": "mnci run lint",
    "test": "mnci run test",
    "typecheck": "mnci run typecheck",
    "affected": "mnci run lint --affected && mnci run typecheck test build --affected",
    "graph": "mnci graph",
    "release:preview": "mnci release --dry-run",
    "prepare": "husky",
    "format": "eslint . --fix --cache",
    "lint:workspace": "eslint . --cache --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"python-packages/**\" --ignore-pattern package-lock.json"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mnci/eslint-config": ">=0.1.0 <1.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "adm-zip": "^0.6.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "tslib": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "brace-expansion@4.0.0 - 5.0.8": "^5.0.9"
  }
}
