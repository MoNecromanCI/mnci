{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": false,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["node", "jest"]
  }
}
